{
  "name": "cutccc",
  "version": "0.3.0",
  "description": "Local video editing with a Node.js service and Python inference workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzj998/cutccc.git"
  },
  "homepage": "https://github.com/wzj998/cutccc#readme",
  "bugs": "https://github.com/wzj998/cutccc/issues",
  "keywords": ["video-editor", "subtitles", "asr", "mcp", "offline"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "bin": {
    "cutccc": "cutccc/node/cli.js"
  },
  "scripts": {
    "start": "node cutccc/node/cli.js serve",
    "test": "node --test tests-node/*.test.js",
    "check": "node --check cutccc/web/app.js && node --check cutccc/web/api-docs.js && node --check cutccc/web/subtitle-style.js && node --check cutccc/web/edit-history.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "cutccc/node",
    "cutccc/web",
    "cutccc/*.py",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
